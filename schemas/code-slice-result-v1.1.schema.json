{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-code-slice/schemas/code-slice-result-v1.1.schema.json",
  "title": "Agent Code Slice CLI Error v1.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "ok",
    "operation",
    "error",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "ok": {
      "const": false
    },
    "operation": {
      "const": "cli"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "recoverable"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "recoverable": {
          "type": "boolean"
        },
        "candidates": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
