{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-code-slice/schemas/code-slice-result-v1.schema.json",
  "title": "Agent Code Slice Result v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "ok",
    "operation",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "ok": {
      "type": "boolean"
    },
    "operation": {
      "enum": [
        "capabilities",
        "outline",
        "slice"
      ]
    },
    "file": {
      "type": "string"
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {},
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "recoverable"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "recoverable": {
          "type": "boolean"
        },
        "candidates": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "meta": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "result"
        ]
      },
      "else": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "additionalProperties": true
}
